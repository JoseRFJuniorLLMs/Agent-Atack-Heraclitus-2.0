      "allowed_targets": [
        "http://127.0.0.1:7475",
        "127.0.0.1:7474",
        "http://127.0.0.1:8080",
        "http://127.0.0.1:8787",
        "http://127.0.0.1:4318",
        "http://127.0.0.1:19000"
      ],
