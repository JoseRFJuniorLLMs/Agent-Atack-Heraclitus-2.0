# Copie somente para uma sessão supervisionada. Não versionar o arquivo real.
HERACLITUS_LLM_BASE_URL=http://127.0.0.1:11434/v1
HERACLITUS_LLM_MODEL=local-model
HERACLITUS_LLM_API_KEY=

# Providers vivos opcionais para campanhas manuais. O serviço smoke pode ficar
# com MockProvider e não precisa destas chaves.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Autorizações efêmeras: deixe vazias no serviço 24/7. Defina apenas no shell
# de uma campanha destrutiva/remota supervisionada.
HERACLITUS_ATTACK_DESTRUCTIVE_TOKEN=
HERACLITUS_REMOTE_LAB_TOKEN=

# Credenciais opcionais do alvo. Nunca versionar valores reais.
HERACLITUS_AGENT_TOKEN=
HERACLITUS_CORE_USERNAME=
HERACLITUS_CORE_PASSWORD=

# O serviço já força cor somente no stream de logs. Os relatórios JSON nunca
# recebem sequências ANSI.
